# Copy these values to the install command environment (or answer its prompts).
# Public deployment (AWS, OCI, NCP, VPS, physical machine with DNS):
PUBLIC_BASE_URL=https://mcp.example.com
CADDY_MODE=public
ENABLE_OAUTH=1
SHARE_DAYS=7

# Local VMware / VirtualBox / physical lab host, SSH tunnel or local usage:
# PUBLIC_BASE_URL=http://127.0.0.1:8088
# CADDY_MODE=local
# ENABLE_OAUTH=0

# Behind an existing external HTTPS reverse proxy:
# PUBLIC_BASE_URL=https://mcp.example.com
# CADDY_MODE=external
# ENABLE_OAUTH=1
# External proxy must forward Host/Authorization and disable response caching.
