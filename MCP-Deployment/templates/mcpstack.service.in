[Unit]
Description=@DESCRIPTION@
After=network-online.target
Wants=network-online.target
@AFTER@

[Service]
Type=simple
User=mcpstack
Group=mcpstack
Environment=HOME=/var/lib/mcpstack
Environment=MCP_INSTALL_ROOT=@ROOT@
EnvironmentFile=@ROOT@/runtime/public.env
WorkingDirectory=@ROOT@
ExecStart=@EXEC@
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
